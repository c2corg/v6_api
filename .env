# Navitia API Key : 400.000 queries each month
NAVITIA_API_KEY="test-key"

# Maximum distance between a waypoint and a stop, in meters
MAX_DISTANCE_WAYPOINT_TO_STOPAREA=5000

# Walking speed in m/s
WALKING_SPEED=1.12

# Maximum number of stops associated with a waypoint
MAX_STOP_AREA_FOR_1_WAYPOINT=5

# Partner outings: key of the skitour.fr API (read by the harvest job)
# SKITOUR_API_KEY=

# How long the planned timetables of the public transport are kept, in seconds
TRANSPORT_CACHE_SECONDS=86400

# Navitia requests that the public transport map may cause in a day (0: no cap).
# The API key allows 400,000 requests a month, shared with the stop imports.
TRANSPORT_MAX_NAVITIA_REQUESTS_PER_DAY=5000
