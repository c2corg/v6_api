# Navitia API Key : 400.000 queries each month
NAVITIA_API_KEY="test-key"

# Maximum distance between a waypoint and a stop, in meters
MAX_DISTANCE_WAYPOINT_TO_STOPAREA=5000

# Walking speed in m/s
WALKING_SPEED=1.12

# Maximum number of stops associated with a waypoint
MAX_STOP_AREA_FOR_1_WAYPOINT=5

# Public transport (GTFS feeds): thresholds of the import and of the API, see
# HOWTO-DEV.md. They are all optional: a value that is not set, or not valid, is
# replaced by the default written here.

# Two stops closer than this (meters) are the same place, whatever their names
TRANSPORT_SAME_PLACE_DISTANCE=15
# Two stops closer than this (meters) are the same place if their names look
# alike or if one of their lines has the same code
TRANSPORT_NEAR_DISTANCE=50
# Two lines of two feeds, with the same mode and code, are duplicates if each
# of their paths is covered by the other one within this distance (meters)...
TRANSPORT_LINE_TOLERANCE=25
# ... on at least this share of its length (0.5 to 1)
TRANSPORT_LINE_OVERLAP=0.9
# A Navitia stop closer than this (meters) to a GTFS stop served by one of its
# lines is the same stop (it is linked to it)
TRANSPORT_LINK_DISTANCE=50
# The paths of the lines are simplified: at most this far (meters) from the
# path of the feed
TRANSPORT_SIMPLIFY_TOLERANCE=5
# Number of days, from the import, the timetables are stored for
TRANSPORT_SERVICE_DAYS=365
# Number of stop sequences of a direction of a line that are kept (the most
# frequent)
TRANSPORT_MAX_VARIANTS_PER_DIRECTION=6
# Maximum number of stops and of lines the API gives for an extent
TRANSPORT_MAX_STOPS_BY_BBOX=5000
TRANSPORT_MAX_LINES_BY_BBOX=500
# Time (seconds) the browsers and the proxies keep the transport data
TRANSPORT_CACHE_MAX_AGE=86400
