###
# app configuration
###

[app:main]
use = config:common.ini

# in dev. mode, append the timestamp to the cache key, so that the cache is
# invalidated when the debug server reloads
cache_version_timestamp = True

sqlalchemy.url = postgresql+psycopg2://{db_user}:{db_password}@{db_host}:{db_port}/{db_name}


show_debugger_for_errors = {show_debugger_for_errors}

###
# logging configuration
###

[loggers]
keys = root, c2corg_api, sqlalchemy, c2corg_api_syncer, c2corg_api_background_jobs, kombu

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = INFO
handlers = console

[logger_c2corg_api]
level = DEBUG
handlers =
qualname = c2corg_api

[logger_c2corg_api_syncer]
level = DEBUG
handlers =
qualname = c2corg_api_syncer

[logger_kombu]
level = WARN
handlers =
qualname = kombu

[logger_c2corg_api_background_jobs]
level = DEBUG
handlers =
qualname = c2corg_api_background_jobs

[logger_sqlalchemy]
level = INFO
handlers =
qualname = sqlalchemy.engine
# "level = INFO" logs SQL queries.
# "level = DEBUG" logs SQL queries and results.
# "level = WARN" logs neither.  (Recommended for production systems.)

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(asctime)s %(levelname)-5.5s [%(name)s][%(threadName)s] %(message)s
