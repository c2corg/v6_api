###
# app configuration
###

[app:main]
use = config:common.ini

sqlalchemy.url = postgresql+psycopg2://{db_user}:{db_password}@{db_host}:{db_port}/{db_name}

###
# logging configuration
###

[loggers]
keys = root, c2corg_api, sqlalchemy, c2corg_api_syncer, c2corg_api_sync, c2corg_api_background_jobs, kombu, gunicorn.error, gunicorn.access, c2corg_api_access, uvicorn.error

[handlers]
keys = console

[formatters]
keys = generic,json

[logger_root]
level = WARN
handlers = console

[logger_c2corg_api]
level = WARN
handlers =
qualname = c2corg_api

[logger_c2corg_api_syncer]
level = INFO
handlers =
qualname = c2corg_api_syncer

[logger_c2corg_api_sync]
level = INFO
handlers =
qualname = c2corg_api.scripts.es.sync

[logger_kombu]
level = WARN
handlers =
qualname = kombu

[logger_c2corg_api_background_jobs]
level = INFO
handlers =
qualname = c2corg_api_background_jobs

[logger_sqlalchemy]
level = WARN
handlers =
qualname = sqlalchemy.engine
# "level = INFO" logs SQL queries.
# "level = DEBUG" logs SQL queries and results.
# "level = WARN" logs neither.  (Recommended for production systems.)

[logger_gunicorn.access]
level = INFO
handlers =
qualname=gunicorn.access

[logger_gunicorn.error]
level = INFO
handlers =
qualname=gunicorn.error

# the access log of the uvicorn workers (c2corg_api.asgi)
[logger_c2corg_api_access]
level = INFO
handlers =
qualname = c2corg_api.access

# the messages of the uvicorn workers, in JSON like the others
[logger_uvicorn.error]
level = INFO
handlers =
qualname = uvicorn.error

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = json

[formatter_generic]
format = %(asctime)s %(levelname)-5.5s [%(name)s][%(threadName)s] %(message)s

[formatter_json]
class = pythonjsonlogger.json.JsonFormatter
format = %(message)%(levelname)%(name)%(asctime)%(funcName)%(lineno)%(pathname)%(stack_info)%(module)%(created)%(threadName)%(processName)%(getMessage)
