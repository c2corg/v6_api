#!/bin/sh

instanceid="dev"
base_url="/${instanceid}"
ui_url="http://localhost:6553"
# 6553: ui_url, kept first (the contract test snapshots expect it); then any port of this machine: the Vite dev servers
# of c2c_ui (npm run serve, 8080 by default, other ports for several worktrees). Patterns of fnmatch: the port starts
# with a digit, so that no other host matches
cors_allowed_origins="http://localhost:6553 http://localhost:[0-9]* http://127.0.0.1:[0-9]*"

db_host="postgresql"
db_name="c2corg"
elasticsearch_host="elasticsearch"
elasticsearch_index="c2corg"

tests_db_host="postgresql"
tests_db_name="c2corg_tests"
tests_elasticsearch_host="elasticsearch"
tests_elasticsearch_index="c2corg_tests"

redis_db_queue=6
redis_db_cache=7
redis_url="redis://redis:6379/"

# nobody runs a Discourse locally: the API makes no call to it (see env.default)
discourse_enabled="false"

# in case of unexpected errors, show the debug toolbar?
show_debugger_for_errors=false

# the demo shows the partner outings of the fixtures, without any network
harvest_partners_enabled="true"
# the sources off by default (env.default) are on here: fixtures, no network
harvest_partners_bivouak_enabled="true"
harvest_partners_gipfelbuch_enabled="true"
harvest_partners_skitourenportal_enabled="true"
partners_transport="fixtures"
# the fixtures are synthetic: fine for the demo
partners_allow_synthetic="true"
