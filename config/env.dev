#!/bin/sh

instanceid="dev"
base_url="/${instanceid}"
ui_url="http://localhost:6553"
# 6553: ui_url, kept first (the contract test snapshots expect it); 8080: the Vite dev server of c2c_ui (npm run serve)
cors_allowed_origins="http://localhost:6553 http://localhost:8080"

db_host="postgresql"
db_name="c2corg"
elasticsearch_host="elasticsearch"
elasticsearch_index="c2corg"

tests_db_host="postgresql"
tests_db_name="c2corg_tests"
tests_elasticsearch_host="elasticsearch"
tests_elasticsearch_index="c2corg_tests"

redis_db_queue=6
redis_db_cache=7
redis_url="redis://redis:6379/"

# nobody runs a Discourse locally: the API makes no call to it (see env.default)
discourse_enabled="false"

# in case of unexpected errors, show the debug toolbar?
show_debugger_for_errors=false