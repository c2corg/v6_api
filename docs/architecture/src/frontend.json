  "cards": [
    {
      "dot": "cyan",
      "title": "Serving",
      "items": [
        "One image for every environment: runtime-config.sh writes config.js from C2C_* variables",
        "Link-preview crawlers get title, Open Graph and JSON-LD from c2c_head.lua; the app replaces them on mount",
        "Per-request CSP nonce on index.html; hashed assets cached 1 year"
      ]
    },
    {
      "dot": "emerald",
      "title": "Recent changes (Sep–Nov 2026)",
      "items": [
        "Vite 8 (Rolldown), Lightning CSS, Bulma as plain CSS with design tokens (no Sass)",
        "AVIF thumbnails for uploads from 2026-11-07; HEIC upload with server preview",
        "Remember-me sessions renewed before expiry, one tab at a time",
        "Unread forum notifications via Discourse MessageBus, polling fallback",
        "Tracking: invite to link a device after a GPS upload, prefill outings from device activities",
        "Justified image rows; routes proposed from an outing's GPS track"
      ]
    },
    {
      "dot": "amber",
      "title": "Previews & trackers",
      "items": [
        "PR previews on GitHub Pages wait for a maintainer's approval and are removed when the PR closes",
        "Preprod and previews connect trackers through the production OAuth return URL (trackers-oauth-relay.ts)"
      ]
    },
    {
      "dot": "slate",
      "title": "Not on master",
      "items": [
        "No service worker / offline mode (preview branches only)",
        "Outings heatmap overlay is API-side; no UI on master yet",
        "Ad script (admysports) and Google Analytics are loaded after load / GDPR consent"
      ]
    }
  ]
